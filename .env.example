# Copy this file to .env and fill it in. .env is ignored by Git.
# With no .env at all, ModuleSim uses the mock AI, which needs no key.

# mock (default, no key needed) or gemini
AI_PROVIDER=mock

# Only needed when AI_PROVIDER=gemini. Get a free key at aistudio.google.com.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Seconds to wait for the AI before trying the fallback
AI_TIMEOUT=20

# Any long random text. Signs the browser session cookie.
SECRET_KEY=change-me
